Project buby_solidale {
  database_type: 'PostgreSQL'
  Note: 'Buby Solidale - schema v1.1 (25 tabelle). Fonte: docs/schema/buby_solidale_schema_v1.1.sql'
}

Enum "solidale"."unita_misura" {
  "kg"
  "pz"
}

Enum "solidale"."macro_categoria" {
  "alimentare"
  "prima_necessita"
}

Enum "solidale"."tipo_donatore" {
  "azienda"
  "privato"
  "ente"
}

Enum "solidale"."ruolo_operatore" {
  "responsabile_punto"
  "operatore_sociale"
}

Enum "solidale"."fascia_eta" {
  "18-29"
  "30-44"
  "45-64"
  "65+"
}

Enum "solidale"."stato_scheda" {
  "attiva"
  "sospesa"
  "chiusa"
}

Enum "solidale"."canale_donazione" {
  "storico"
  "app"
  "email"
  "telefono"
}

Enum "solidale"."stato_donazione_t" {
  "offerta"
  "accettata"
  "rifiutata"
  "ritiro_programmato"
  "ricevuta"
  "annullata"
}

Enum "solidale"."causale_scarto" {
  "scaduto"
  "non_idoneo"
  "danneggiato"
}

Enum "solidale"."fonte_distribuzione" {
  "stimata_bilancio"
  "registrata_app"
}

Enum "solidale"."fascia_turno" {
  "mattina"
  "pomeriggio"
}

Enum "solidale"."stato_assegnazione" {
  "pianificato"
  "coperto"
  "parziale"
  "scoperto"
  "sostituito"
}

Enum "solidale"."fonte_messaggio" {
  "email"
  "chat_volontari"
  "nota_operatore"
  "recensione"
  "feedback_app"
}

Enum "solidale"."ruolo_autore" {
  "donatore"
  "partner"
  "ente_pubblico"
  "volontario"
  "operatore"
  "visitatore"
  "altro"
  "beneficiario"
}

Enum "solidale"."origine_segnalazione" {
  "app"
  "messaggio"
}

Enum "solidale"."priorita_t" {
  "bassa"
  "media"
  "alta"
}

Enum "solidale"."stato_segnalazione" {
  "aperta"
  "in_gestione"
  "chiusa"
}

Enum "solidale"."target_previsione" {
  "donato_kg"
  "distribuito_kg"
  "eccedenza_kg"
  "turni_scoperti"
}

Enum "solidale"."stato_trasferimento" {
  "suggerito"
  "avvisato"
  "fatto"
  "ignorato"
}

Enum "solidale"."sentiment_t" {
  "negativo"
  "neutro"
  "positivo"
}

Enum "solidale"."tipo_caricamento" {
  "giacenze"
  "scarti"
}

Enum "solidale"."stato_caricamento" {
  "in_attesa"
  "in_elaborazione"
  "completato"
  "completato_con_scarti"
  "errore"
}

Table "solidale"."punto_ritiro" [headercolor: #2F6FA3] {
  "id" text [pk, check: `id ~ '^PR[0-9]{2}$'`]
  "nome" text [unique, not null]
  "comune" text [not null]
  "indirizzo" text [not null]
  "capienza_kg" numeric(8,1) [check: `capienza_kg > 0`, note: 'NULL per PR06: dato mancante nella fonte.']
  "frigorifero" boolean [not null]
  Note: 'Fonte: anagrafiche_buby_solidale.xlsx, foglio "Punti di ritiro" (7 punti).'
}

Table "solidale"."punto_apertura" [headercolor: #2F6FA3] {
  "punto_id" text [not null]
  "giorno_settimana" smallint [not null, check: `giorno_settimana BETWEEN 1 AND 7`]
  "ora_apertura" time [not null]
  "ora_chiusura" time [not null]

  Checks {
    `ora_chiusura > ora_apertura`
  }

  Indexes {
    (punto_id, giorno_settimana, ora_apertura) [pk]
  }
  Note: 'Normalizza "giorni_apertura" e "orario" della fonte. giorno_settimana: 1 = lunedi (ISO).'
}

Table "solidale"."categoria_prodotto" [headercolor: #2F6FA3] {
  "id" smallint [pk, increment]
  "nome" text [unique, not null]
  "macro" solidale.macro_categoria [not null]
  "unita_standard" solidale.unita_misura [not null]
  "peso_medio_pz_kg" numeric(6,3) [check: `peso_medio_pz_kg > 0`, note: 'Ipotesi dichiarata (dato sintetico ammesso dal committente) per convertire i pezzi in kg.']
  "deperibile" boolean [not null]
  "richiede_frigo" boolean [not null]
  "conta_come_pasti" boolean [not null, note: 'false per igiene e detersivi: non entrano nel calcolo dei pasti.']

  Checks {
    `unita_standard = 'kg' OR peso_medio_pz_kg IS NOT NULL`
  }
  Note: '14 categorie canoniche. I 51 nomi grezzi della fonte sono mappati nella pipeline di pulizia.'
}

Table "solidale"."donatore" [headercolor: #2F6FA3] {
  "id" text [pk, check: `id ~ '^D[0-9]{3}$'`]
  "tipo" solidale.tipo_donatore
  "tipo_sintetico" boolean [not null, default: false]
  Note: 'Solo codici (D001-D036). Il tipo non e nella fonte: NULL o sintetico dichiarato.'
}

Table "solidale"."volontario" [headercolor: #2F6FA3] {
  "id" text [pk, check: `id ~ '^V[0-9]{3}$'`]
  "punto_preferito_id" text
  "attivo" boolean [not null, default: true]
}

Table "solidale"."operatore" [headercolor: #2F6FA3] {
  "id" text [pk, check: `id ~ '^OP[0-9]{2}$'`]
  "ruolo" solidale.ruolo_operatore
  Note: 'OP01-OP06 compaiono sia negli scarti sia nelle note degli operatori sociali: ruolo da confermare.'
}

Table "solidale"."beneficiario" [headercolor: #2F6FA3] {
  "id" text [pk, check: `id ~ '^B[0-9]{4}$'`]
  "fascia_eta_referente" solidale.fascia_eta [not null]
  "n_componenti" smallint [not null, check: `n_componenti >= 1`]
  "n_minori" smallint [check: `n_minori >= 0`, note: '21 valori mancanti nella fonte.']
  "n_over65" smallint [not null, check: `n_over65 >= 0`]
  "comune_residenza" text [not null]
  "punto_riferimento_id" text [not null]
  "data_prima_registrazione" date [not null]
  "accessi_ultimi_12_mesi" smallint [not null, check: `accessi_ultimi_12_mesi >= 0`]
  "accessi_riferiti_al" date [not null, default: `DATE'2026-10-31'`]
  "stato_scheda" solidale.stato_scheda [not null]

  Checks {
    `n_minori IS NULL OR n_minori + n_over65 <= n_componenti`
  }
  Note: 'Fonte: foglio "Beneficiari anonimi" (452 righe, 450 codici unici). Nessun dato identificativo.'
}

Table "solidale"."donazione" [headercolor: #3A8E5F] {
  "id" text [pk, check: `id ~ '^DON-[0-9]{5}$'`, default: `'DON-'||lpad(nextval('solidale.donazione_app_seq')::text,5,'0')`]
  "data" date [not null]
  "donatore_id" text [note: 'NULL in 85 donazioni della fonte.']
  "punto_id" text [not null]
  "canale" solidale.canale_donazione [not null, default: 'storico']
  "messaggio_id" bigint
  "stato_corrente" solidale.stato_donazione_t [not null, default: 'ricevuta', note: 'Aggiornato dal trigger su stato_donazione.']

  Indexes {
    (punto_id, data) [name: "ix_donazione_punto_data"]
    donatore_id [name: "ix_donazione_donatore"]
  }
  Note: 'Fonte: donazioni_set2025_ott2026.xlsx (3.385 donazioni).'
}

Table "solidale"."donazione_riga" [headercolor: #3A8E5F] {
  "id" bigint [pk, increment]
  "donazione_id" text [not null]
  "categoria_id" smallint [not null]
  "prodotto_originale" text [not null]
  "quantita" numeric(10,2) [not null, check: `quantita > 0`]
  "unita" solidale.unita_misura [not null]
  "kg" numeric(10,2) [not null, check: `kg > 0`]
  "kg_stimato" boolean [not null]

  Checks {
    `unita = 'pz' OR (kg = quantita AND NOT kg_stimato)`
  }

  Indexes {
    donazione_id [name: "ix_riga_donazione"]
    categoria_id [name: "ix_riga_categoria"]
  }
  Note: 'Fonte: 6.847 righe. kg = quantita se in kg, altrimenti quantita * peso_medio_pz_kg (kg_stimato = true).'
}

Table "solidale"."stato_donazione" [headercolor: #3A8E5F] {
  "id" bigint [pk, increment]
  "donazione_id" text [not null]
  "stato" solidale.stato_donazione_t [not null]
  "cambiato_il" timestamptz [not null, default: `now()`]
  "utente_id" bigint
  "nota" text

  Indexes {
    (donazione_id, cambiato_il) [name: "ix_stato_donazione"]
  }
  Note: 'Storico degli stati per le donazioni inserite dall app. Le storiche hanno una sola riga "ricevuta".'
}

Table "solidale"."giacenza" [headercolor: #3A8E5F] {
  "data_rilevazione" date [not null]
  "punto_id" text [not null]
  "categoria_id" smallint [not null]
  "quantita" numeric(10,2) [not null, check: `quantita >= 0`]
  "unita" solidale.unita_misura [not null]
  "kg" numeric(10,2) [not null, check: `kg >= 0`]
  "scadenza_piu_vicina" date [note: '340 righe della fonte hanno una scadenza gia passata alla data di rilevazione.']

  Checks {
    `extract(isodow FROM data_rilevazione) = 1`
  }

  Indexes {
    (data_rilevazione, punto_id, categoria_id) [pk]
    scadenza_piu_vicina [name: "ix_giacenza_scadenza"]
  }
  Note: 'Fonte: foglio "Giacenze". Fotografia di ogni lunedi per punto e categoria (61 settimane).'
}

Table "solidale"."scarto" [headercolor: #3A8E5F] {
  "id" bigint [pk, increment]
  "data" date [not null]
  "punto_id" text [not null]
  "categoria_id" smallint [not null]
  "prodotto_originale" text [not null]
  "quantita" numeric(10,2) [not null, check: `quantita > 0`]
  "unita" solidale.unita_misura [not null]
  "kg" numeric(10,2) [not null, check: `kg > 0`]
  "causale" solidale.causale_scarto [not null]
  "causale_originale" text [not null]
  "operatore_id" text

  Indexes {
    (punto_id, data) [name: "ix_scarto_punto_data"]
  }
  Note: 'Fonte: foglio "Scarti". Stima minima dello spreco: la registrazione non e uniforme tra i punti (committente, 12/11/2026).'
}

Table "solidale"."distribuzione" [headercolor: #3A8E5F] {
  "id" bigint [pk, increment]
  "punto_id" text [not null]
  "categoria_id" smallint [not null]
  "periodo_inizio" date [not null]
  "periodo_fine" date [not null]
  "kg" numeric(10,2) [not null, check: `kg >= 0`]
  "beneficiario_id" text
  "fonte" solidale.fonte_distribuzione [not null]

  Checks {
    `periodo_fine >= periodo_inizio`
    `fonte = 'registrata_app' OR beneficiario_id IS NULL`
  }

  Indexes {
    (punto_id, periodo_inizio) [name: "ix_distribuzione_punto"]
  }
  Note: 'La fonte non contiene distribuzioni. stimata_bilancio = giacenza inizio + donato - scartato - giacenza fine, per settimana. registrata_app = inserite in futuro dall app.'
}

Table "solidale"."turno" [headercolor: #D08A2E] {
  "id" bigint [pk, increment]
  "punto_id" text [not null]
  "data" date [not null]
  "fascia" solidale.fascia_turno [not null]
  "ora_inizio" time [not null]
  "ora_fine" time [not null]

  Checks {
    `ora_fine > ora_inizio`
  }

  Indexes {
    (punto_id, data, fascia) [unique]
  }
  Note: 'Lo slot (punto + data + fascia), ricavato dalle righe del foglio "Turni".'
}

Table "solidale"."assegnazione" [headercolor: #D08A2E] {
  "id" text [pk, check: `id ~ '^T[0-9]{5}$'`]
  "turno_id" bigint [not null]
  "volontario_id" text [not null]
  "ore_pianificate" numeric(4,1) [not null, check: `ore_pianificate > 0`]
  "ore_effettive" numeric(4,1) [check: `ore_effettive >= 0`]
  "stato" solidale.stato_assegnazione [not null]
  "sostituto_id" text

  Checks {
    `(stato = 'sostituito') = (sostituto_id IS NOT NULL)`
    `stato <> 'scoperto' OR ore_effettive IS NULL`
    `sostituto_id IS DISTINCT FROM volontario_id`
  }

  Indexes {
    turno_id [name: "ix_assegnazione_turno"]
    volontario_id [name: "ix_assegnazione_volont"]
  }
  Note: 'Fonte: foglio "Turni" (4.469 righe). Ogni riga e un volontario assegnato a uno slot; il suo id_turno (T00001) diventa l id dell assegnazione.'
}

Table "solidale"."messaggio" [headercolor: #7A5BA6] {
  "id" bigint [pk, increment]
  "fonte" solidale.fonte_messaggio [not null]
  "ricevuto_il" timestamptz [not null]
  "autore_ruolo" solidale.ruolo_autore
  "operatore_id" text
  "beneficiario_id" text
  "voto" smallint [check: `voto BETWEEN 1 AND 5`]
  "oggetto" text
  "testo_anonimizzato" text [not null, note: 'Le note operatori contengono dati art. 9 GDPR (salute, religione): ridurre a etichette dove possibile.']
  "categoria_predetta" text
  "confidenza" numeric(4,3) [check: `confidenza BETWEEN 0 AND 1`]
  "entita_estratte" jsonb
  "etichetta_manuale" text [note: 'Etichetta assegnata a mano: serve a misurare precision, recall e F1 del classificatore.']
  "modello_versione" text
  "punto_id" text [note: 'Punto a cui si riferisce il messaggio (facoltativo), es. il punto valutato in un feedback.']
  "sentiment" solidale.sentiment_t [note: 'Scritto dal modello di sentiment, come categoria_predetta.']
  "sentiment_punteggio" numeric(4,3) [check: `sentiment_punteggio BETWEEN -1 AND 1`, note: 'Da -1 (molto negativo) a +1 (molto positivo).']

  Checks {
    `fonte::text IN ('recensione', 'feedback_app') OR voto IS NULL` [name: 'messaggio_voto_solo_recensioni_e_feedback']
    `fonte = 'nota_operatore' OR (operatore_id IS NULL AND beneficiario_id IS NULL)` [name: 'messaggio_nota_solo_operatore']
  }

  Indexes {
    (fonte, ricevuto_il) [name: "ix_messaggio_fonte_data"]
    entita_estratte [type: gin, name: "ix_messaggio_entita"]
  }
  Note: 'Fonte: comunicazioni_e_note.docx. Il testo si salva solo dopo l anonimizzazione (nomi, telefoni, email, codici fiscali).'
}

Table "solidale"."segnalazione" [headercolor: #7A5BA6] {
  "id" bigint [pk, increment]
  "origine" solidale.origine_segnalazione [not null]
  "messaggio_id" bigint
  "autore_ruolo" solidale.ruolo_autore
  "creata_il" timestamptz [not null, default: `now()`]
  "categoria" text [not null, note: 'Esempi dai testi: catena_freddo, scorte_esaurite, turno_scoperto, ricevuta_mancante, frigo_guasto.']
  "priorita" solidale.priorita_t [not null]
  "stato" solidale.stato_segnalazione [not null, default: 'aperta']
  "chiusa_il" timestamptz
  "testo_anonimizzato" text
  "donazione_id" text
  "punto_id" text
  "turno_id" bigint

  Checks {
    `num_nonnulls(donazione_id, punto_id, turno_id) >= 1`
    `origine = 'app' OR messaggio_id IS NOT NULL`
    `(stato = 'chiusa') = (chiusa_il IS NOT NULL)`
  }

  Indexes {
    (priorita, creata_il) [name: "ix_segnalazione_aperte"]
  }
}

Table "solidale"."caricamento" [headercolor: #3A8E5F] {
  "id" bigint [pk, increment]
  "tipo" solidale.tipo_caricamento [not null]
  "nome_file" text [not null]
  "percorso_file" text [not null, note: 'Dove sta il file grezzo nello storage di staging, es. staging/2026-11-23/giacenze_PR03.xlsx.']
  "caricato_da" bigint [note: 'Id dell utente in riservato.utente (senza vincolo, cosi il team dati non legge lo schema riservato).']
  "caricato_il" timestamptz [not null, default: `now()`]
  "stato" solidale.stato_caricamento [not null, default: 'in_attesa']
  "elaborato_il" timestamptz
  "righe_lette" integer [check: `righe_lette >= 0`]
  "righe_caricate" integer [check: `righe_caricate >= 0`]
  "righe_scartate" integer [check: `righe_scartate >= 0`]
  "errori" jsonb [note: 'Righe scartate e perche, es. [{"riga": 14, "motivo": "data illeggibile"}].']

  Checks {
    `righe_caricate IS NULL OR righe_lette IS NULL OR righe_caricate + coalesce(righe_scartate, 0) <= righe_lette`
  }

  Indexes {
    (caricato_il [desc]) [name: "ix_caricamento_data"]
  }
  Note: 'Un file caricato dall app. Lo scrive il backend (in_attesa); la pipeline aggiorna stato, conteggi ed errori.'
}

Table "solidale"."previsione" [headercolor: #B9622A] {
  "id" bigint [pk, increment]
  "target" solidale.target_previsione [not null]
  "punto_id" text [not null]
  "categoria_id" smallint
  "periodo_inizio" date [not null]
  "periodo_fine" date [not null]
  "valore_previsto" numeric(12,2) [not null]
  "intervallo_basso" numeric(12,2)
  "intervallo_alto" numeric(12,2)
  "valore_reale" numeric(12,2)
  "modello" text [not null]
  "versione" text [not null]
  "generata_il" timestamptz [not null, default: `now()`]

  Checks {
    `periodo_fine >= periodo_inizio`
    `intervallo_basso IS NULL OR intervallo_basso <= valore_previsto`
    `intervallo_alto  IS NULL OR intervallo_alto  >= valore_previsto`
  }

  Indexes {
    (target, punto_id, categoria_id, periodo_inizio, modello, versione) [unique]
  }
  Note: 'Ogni stima accanto al valore reale: le metriche di errore (MAE, WAPE) sono nella vista v_accuratezza_previsioni.'
}

Table "solidale"."parametro" [headercolor: #B9622A] {
  "chiave" text [pk]
  "valore" numeric [not null]
  "unita" text
  "fonte" text [not null]
  "valido_dal" date [not null]
}

Table "solidale"."rischio_assegnazione" [headercolor: #B9622A] {
  "assegnazione_id" text [pk]
  "probabilita" numeric(4,3) [not null, check: `probabilita BETWEEN 0 AND 1`]
  "modello" text [not null]
  "versione" text [not null]
  "generata_il" timestamptz [not null, default: `now()`]
  Note: 'Probabilita stimata che l assegnazione resti scoperta. Una riga per assegnazione, sovrascritta a ogni esecuzione del modello.'
}

Table "solidale"."sostituto_suggerito" [headercolor: #B9622A] {
  "assegnazione_id" text [not null]
  "volontario_id" text [not null]
  "posizione" smallint [not null, check: `posizione BETWEEN 1 AND 5`]
  "punteggio" numeric(4,3) [not null, check: `punteggio BETWEEN 0 AND 1`]
  "motivi" "text[]" [not null, default: '{}', note: 'Frasi brevi mostrate cosi come sono, es. "Punto preferito PR03".']
  "modello" text [not null]
  "versione" text [not null]
  "generata_il" timestamptz [not null, default: `now()`]

  Indexes {
    (assegnazione_id, volontario_id) [pk]
    (assegnazione_id, posizione) [unique]
  }
}

Table "solidale"."trasferimento_suggerito" [headercolor: #B9622A] {
  "id" bigint [pk, increment]
  "settimana" date [not null, check: `extract(isodow FROM settimana) = 1`]
  "da_punto_id" text [not null]
  "a_punto_id" text [not null]
  "categoria_id" smallint [not null]
  "kg" numeric(10,2) [not null, check: `kg > 0`]
  "scadenza_piu_vicina" date
  "motivo" text [not null]
  "messaggio_volontari" text [not null, note: 'Testo pronto da copiare. Mai nomi di persone: i nomi li aggiunge il backend solo per il coordinatore.']
  "volontari_suggeriti" "text[]" [not null, default: '{}', note: 'Codici volontario (V012...) in ordine di preferenza.']
  "stato" solidale.stato_trasferimento [not null, default: 'suggerito']
  "modello" text [not null]
  "versione" text [not null]
  "generata_il" timestamptz [not null, default: `now()`]

  Checks {
    `da_punto_id <> a_punto_id`
  }

  Indexes {
    (settimana, da_punto_id) [name: "ix_trasferimento_settimana"]
  }
}

Enum "riservato"."ruolo_utente" {
  "coordinatore"
  "operatore"
  "volontario"
  "donatore"
  "partner"
  "admin"
}

Table "riservato"."utente" [headercolor: #C0392B] {
  "id" bigint [pk, increment]
  "email" text [unique, not null]
  "password_hash" text [not null]
  "ruolo" riservato.ruolo_utente [not null]
  "soggetto_id" text [note: 'Codice D.., V.. o OP.. collegato all account.']
  "attivo" boolean [not null, default: true]
  "creato_il" timestamptz [not null, default: `now()`]
}

Table "riservato"."anagrafica_riservata" [headercolor: #C0392B] {
  "soggetto_id" text [pk]
  "nome_o_ragione_sociale" text [not null]
  "email" text
  "telefono" text
  Note: 'Dati identificativi, solo coordinatori e admin. Vuota per lo storico: la fonte Excel contiene solo codici.'
}

Ref:"solidale"."punto_ritiro"."id" <? "solidale"."punto_apertura"."punto_id"

Ref:"solidale"."punto_ritiro"."id" ?<? "solidale"."volontario"."punto_preferito_id"

Ref:"solidale"."punto_ritiro"."id" <? "solidale"."beneficiario"."punto_riferimento_id"

